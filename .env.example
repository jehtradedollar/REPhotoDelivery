# Copy to .env.local. Leaving a provider's keys empty keeps it on the mock implementation.

# Storage (S3)
STORAGE_PROVIDER=mock            # mock | s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_CDN_URL=                   # optional CloudFront domain

# Payments (Stripe)
PAYMENT_PROVIDER=mock            # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Calendar (Google Calendar)
CALENDAR_PROVIDER=mock           # mock | google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

APP_URL=http://localhost:3000
