# Copy to .env.local for development. In production set these in your host
# (e.g. Vercel project settings). Any service left blank runs on a stand-in:
# local disk, demo checkout, emails and texts written to the server log.

# --- Required ---
DATABASE_URL=postgres://postgres@localhost:5432/rpd
AUTH_SECRET=                      # 32+ random characters: openssl rand -base64 32
APP_URL=http://localhost:3000     # public URL; used in emails, texts and Stripe/Google redirects

# --- Studio ---
NEXT_PUBLIC_STUDIO_NAME=Northlight Media
NEXT_PUBLIC_STUDIO_SHORT_NAME=Northlight   # used in preview watermarks
NEXT_PUBLIC_STUDIO_EMAIL=hello@example.com
NEXT_PUBLIC_STUDIO_PHONE=(530) 555-0100
NEXT_PUBLIC_PHOTOGRAPHER_NAME=Jonathan
NEXT_PUBLIC_STUDIO_TIMEZONE=America/Los_Angeles
INVOICE_DUE_DAYS=7
DEFAULT_TAX_RATE=0                # e.g. 0.0725 for 7.25%

# --- Demo ---
DEMO_MODE=false                   # true shows one-click demo sign-in and allows the demo checkout in production
SEED_PASSWORD=demo1234            # npm run db:seed
OWNER_EMAIL=owner@example.com

# --- Media storage: Amazon S3 (or any S3-compatible store) ---
STORAGE_PROVIDER=local            # local | s3
LOCAL_STORAGE_DIR=.uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=                      # only for S3-compatible stores (R2, MinIO, Wasabi)
MEDIA_CDN_URL=                    # optional CloudFront domain for thumbnails and previews

# --- Payments: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # webhook endpoint: {APP_URL}/api/webhooks/stripe

# --- Calendar: Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=             # OAuth redirect URI: {APP_URL}/api/google/callback
GOOGLE_CALENDAR_ID=primary

# --- Email ---
SMTP_URL=                         # e.g. smtps://user:pass@smtp.postmarkapp.com:465
MAIL_FROM=                        # defaults to "Studio Name <studio email>"

# --- Text messages: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # your Twilio number in +1... form, or use a messaging service
TWILIO_MESSAGING_SERVICE_SID=

# --- Virtual staging AI ---
VIRTUAL_STAGING_API_URL=          # blank = requests queue for you to fulfil by hand
VIRTUAL_STAGING_API_KEY=
VIRTUAL_STAGING_WEBHOOK_SECRET=   # vendor callbacks: {APP_URL}/api/webhooks/staging
CRON_SECRET=                      # optional: polls staging jobs at /api/cron/staging
